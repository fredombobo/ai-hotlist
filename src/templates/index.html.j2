<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI 热点日报</title>
<style>
  :root {
    --bg: #fafafa;
    --surface: #ffffff;
    --border: #e5e5e5;
    --border-strong: #d4d4d4;
    --text: #18181b;
    --text-2: #52525b;
    --text-3: #a1a1aa;
    --lime: #C5E803;
    --lime-soft: #f2fac4;
    --radius: 6px;
    --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
            "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .wrap { max-width: 880px; margin: 0 auto; padding: 0 24px 80px; }

  /* ---------- Header ---------- */
  header {
    border-bottom: 1px solid var(--border);
    padding: 40px 0 24px;
    margin-bottom: 32px;
  }
  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 10px;
  }
  h1 {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  h1 .dot { color: var(--lime); }
  .stats { display: flex; gap: 20px; flex-wrap: wrap; font-size: 13px; }
  .stat { display: flex; align-items: baseline; gap: 6px; color: var(--text-2); }
  .stat b {
    font-family: var(--mono);
    font-size: 15px;
    color: var(--text);
    font-weight: 600;
  }

  /* ---------- 简报预览 ---------- */
  .preview {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 40px;
    overflow: hidden;
  }
  .preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: #f4f4f5;
  }
  .preview-head span {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .preview-head em {
    font-style: normal;
    font-size: 11px;
    color: var(--text-3);
  }
  pre.brief {
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.85;
    color: var(--text);
    padding: 18px 20px;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* ---------- Sections ---------- */
  section { margin-bottom: 44px; }
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-bottom: 12px;
    margin-bottom: 2px;
    border-bottom: 2px solid var(--text);
  }
  .sec-head .ico { font-size: 17px; }
  .sec-head h2 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .sec-head .hint {
    font-size: 12.5px;
    color: var(--text-3);
    margin-left: 2px;
  }
  .sec-head .n {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
  }

  /* ---------- Item ---------- */
  .item {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 0 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }
  .item:last-child { border-bottom: none; }
  .item .idx {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-3);
    padding-top: 2px;
  }
  .item .lead {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    margin-bottom: 6px;
    letter-spacing: -0.005em;
  }
  .item .lead a { color: var(--text); text-decoration: none; }
  .item .lead a:hover {
    text-decoration: underline;
    text-decoration-color: var(--lime);
    text-decoration-thickness: 2.5px;
    text-underline-offset: 3px;
  }
  .item .orig {
    font-size: 13px;
    color: var(--text-2);
    margin-bottom: 8px;
    line-height: 1.55;
  }
  .item .meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
  }
  .item .meta .tag {
    padding: 2px 7px;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    color: var(--text-2);
    background: var(--surface);
  }
  .item .meta .hot {
    background: var(--lime-soft);
    border-color: var(--lime);
    color: #4a5700;
    font-weight: 600;
  }

  footer {
    border-top: 1px solid var(--border);
    padding-top: 20px;
    font-size: 12px;
    color: var(--text-3);
    font-family: var(--mono);
    line-height: 1.9;
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="kicker">Daily Briefing</div>
    <h1>AI 热点日报<span class="dot">.</span></h1>
    <div class="stats">
      {% for s in stats %}
      <span class="stat">{{ s.icon }} {{ s.label }} <b>{{ s.count }}</b></span>
      {% endfor %}
      <span class="stat" style="margin-left:auto">{{ generated_at }} CST</span>
    </div>
  </header>

  <div class="preview">
    <div class="preview-head">
      <span>简报预览 · 企业微信实际观感</span>
      <em>docs/brief.txt</em>
    </div>
    <pre class="brief">{{ brief_text }}</pre>
  </div>

  {% for sec in sections %}
  <section>
    <div class="sec-head">
      <span class="ico">{{ sec.icon }}</span>
      <h2>{{ sec.label }}</h2>
      <span class="hint">{{ sec.hint }}</span>
      <span class="n">{{ sec.articles|length }}</span>
    </div>
    {% for item in sec.articles %}
    <div class="item">
      <div class="idx">{{ "%02d"|format(loop.index) }}</div>
      <div>
        <div class="lead">
          <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.brief or item.title }}</a>
        </div>
        {% if item.brief and item.brief != item.title %}
        <div class="orig">{{ item.title }}</div>
        {% endif %}
        <div class="meta">
          {% if item.extra.get('stars') %}
          <span class="tag hot">⭐ {{ item.extra.stars }}</span>
          {% endif %}
          {% if item.extra.get('language') and item.extra.language != 'unknown' %}
          <span class="tag">{{ item.extra.language }}</span>
          {% endif %}
          {% if item.extra.get('source_name') %}
          <span class="tag">{{ item.extra.source_name }}</span>
          {% endif %}
          {% for t in item.tags[:2] %}
          <span class="tag">{{ t }}</span>
          {% endfor %}
          <span>{{ sec.fmt_time(item.published_at) }}</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endfor %}

  <footer>
    AI 热点日报 · 每日自动更新<br>
    数据来源：GitHub · 英文媒体与博客 · arXiv<br>
    生成时间 {{ generated_at }} CST
  </footer>

</div>
</body>
</html>
